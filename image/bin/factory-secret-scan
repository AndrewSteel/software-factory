#!/usr/bin/env bash
# Prüft Commits auf Zugangsdaten, bevor sie GitHub erreichen. Läuft automatisch vor jedem "git push"
# (Hook /factory/git-hooks/pre-push) und als fester Check in factory-verify.
#
#   factory-secret-scan [<von>..<bis>]     Standard: origin/<standard-branch>..HEAD
#
# Geprüft wird jeder Commit im Bereich, nicht nur der Endstand (auch eine wieder gelöschte Datei wäre
# auf GitHub sichtbar):
#   1. keine .env-Dateien (außer *.example), Schlüssel, Zertifikate, Passwortdateien
#   2. keine Werte der Zugangsdaten dieses Jobs (GH_TOKEN, CLAUDE_CODE_OAUTH_TOKEN, ANTHROPIC_API_KEY)
#   3. gitleaks (bekannte Token-Formate, private Schlüssel, Passwörter in Verbindungs-URLs …)
set -uo pipefail

RANGE="${1:-origin/${FACTORY_DEFAULT_BRANCH:-main}..HEAD}"
if ! git rev-list --quiet "$RANGE" 2>/dev/null; then
  echo "Commit-Bereich $RANGE ist nicht lesbar (git fetch?)." >&2
  exit 2
fi
FAILED=0

# 1. Verbotene Dateien in irgendeinem Commit des Bereichs
BAD=$(git log --format= --name-only --diff-filter=ACMR "$RANGE" | sort -u \
  | grep -Ei '(^|/)(\.env(\.[^/]+)?|[^/]+\.env|[^/]+\.(pem|key|p12|pfx|password)|id_(rsa|dsa|ecdsa|ed25519)|secrets\.ya?ml|passwords?\.txt|credentials\.json|\.npmrc|\.pypirc)$' \
  | grep -Eiv '\.(example|sample|template|dist)$' || true)
if [ -n "$BAD" ]; then
  echo "✗ Diese Dateien gehören nie ins Repo (Zugangsdaten):"
  printf '    %s\n' $BAD
  echo "  Für Beispielwerte: <name>.example anlegen. Echte Werte bleiben in .env auf dem Server."
  FAILED=1
fi

# 2. Zugangsdaten dieses Jobs im Inhalt (exakter Vergleich, der Wert wird nie ausgegeben)
PATCH=$(git log -p --format= "$RANGE")
for VAR in GH_TOKEN GITHUB_TOKEN CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY; do
  VAL="${!VAR:-}"
  if [ "${#VAL}" -ge 16 ] && grep -qF -- "$VAL" <<<"$PATCH"; then
    echo "✗ Der Wert von \$$VAR steht in einem Commit."
    FAILED=1
  fi
done

# 3. Passwörter in Konfiguration und Verbindungs-URLs (neu hinzugefügte Zeilen).
#    Erlaubt sind Wegwerf- und Platzhalterwerte (test, changeme, ${VAR}, <...>, your-...).
#    Bewusste Ausnahme: Zeile mit "gitleaks:allow" markieren (sichtbar im Review).
HITS=$(printf '%s\n' "$PATCH" | awk '
  BEGIN { ok = "^(test|testing|change[-_]?me|password|passwd|secret|example|sample|placeholder|dummy|fake|replace|x+|\\*+|none|null|empty)([-_.][a-z0-9_.-]*)?$" }
  /^\+\+\+ / { file = substr($0, 7); next }
  /^\+/ && !/gitleaks:allow/ && length($0) < 400 && file !~ /(\/_next\/|\.min\.js$)/ {
    line = substr($0, 2); val = ""
    if (match(line, /:\/\/[^:\/@ \t"]+:[^@ \t"]+@/)) {                          # scheme://user:pw@host
      s = substr(line, RSTART + 3, RLENGTH - 4); val = substr(s, index(s, ":") + 1)
    } else if (match(line, /[A-Z0-9_]*(PASSWORD|PASSWD|SECRET|TOKEN|API_KEY|PRIVATE_KEY)["\047]?[ \t]*[:=][ \t]*["\047]?[^ \t"\047#,}]+/)) {
      s = substr(line, RSTART, RLENGTH); sub(/^[^:=]*[:=][ \t]*["\047]?/, "", s); val = s
    }
    if (val == "" || length(val) < 6) next
    v = tolower(val)
    if (v ~ ok || v ~ /^(\$\{|\$[a-z_]|<|your[-_]|\{\{|os\.|env\.|process\.|getenv|settings\.|config\.)/ || v ~ /\(/) next
    if (val ~ /^[A-Z_][A-Z0-9_]*$/) next                                     # Verweis auf eine Variable
    i = index(line, val)                                                     # Wert maskieren, nie ausgeben
    masked = substr(line, 1, i - 1) "***" substr(line, i + length(val))
    gsub(/^[ \t]+/, "", masked)
    print "    " file ": " substr(masked, 1, 70) (length(masked) > 70 ? "…" : "")
  }' | sort -u | head -20)
if [ -n "$HITS" ]; then
  echo "✗ Mögliche Passwörter oder Tokens in neuen Zeilen (Werte maskiert):"
  printf '%s\n' "$HITS"
  echo "  Echte Werte gehören in .env auf dem Server. In Tests nur Wegwerf-Werte wie 'test' verwenden,"
  echo "  in Vorlagen Platzhalter (\${VAR}, <passwort>, changeme)."
  FAILED=1
fi

# 4. gitleaks
if ! command -v gitleaks >/dev/null; then
  echo "✗ gitleaks ist nicht installiert, ohne Scan gilt nichts als geprüft."
  FAILED=1
elif ! OUT=$(gitleaks git --no-banner --redact --log-opts="$RANGE" . 2>&1); then
  echo "✗ gitleaks hat mögliche Zugangsdaten gefunden:"
  printf '%s\n' "$OUT" | grep -E '^(Finding|Secret|RuleID|File|Line|Commit):' | sed 's/^/    /' | head -40
  echo "  Echte Zugangsdaten: aus dem Verlauf entfernen (Commit neu schreiben, vor dem ersten Push)."
  echo "  Testwerte (z. B. Passwort 'test' für einen Wegwerf-Container): eindeutig als Test kennzeichnen, sonst .gitleaksignore."
  FAILED=1
fi

[ $FAILED -eq 0 ] && echo "✓ Keine Zugangsdaten in $RANGE"
exit $FAILED
